# perq POC environment (copy to .env; do NOT commit .env)
DATABASE_URL="postgresql://perq:perq@localhost:5432/perq_poc?schema=public"
PORT=3000

# Mapbox public token for the bare map page (client-side). Never commit a real token.
# NOTE: POC uses SYNTHETIC data only — no Mapbox place data is stored (see docs/DEV_LOG.md).
MAPBOX_PUBLIC_TOKEN="pk.your_public_token_here"
