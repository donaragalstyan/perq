# perq environment (copy to .env; never commit .env)
# Local dev DB is on host port 5433 (see docker-compose.yml).
DATABASE_URL="postgresql://perq:perq@localhost:5433/perq?schema=public"

# Map rendering (client-side public token). Mapbox is rendering-only; place data is NOT
# persisted from Mapbox (see docs/PLACE_DATA_STRATEGY.md).
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_public_token_here"

# Cognito (later spec — not used in Phase 1).
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
